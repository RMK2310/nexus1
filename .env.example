# NEXUS Local Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit your actual .env file to version control.

# Server Settings
PORT=3000
NODE_ENV=development

# Database Configuration
# SQLite (local development):
DATABASE_URL="file:d:/NEXUS1/nexus.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/nexus?schema=public"

# JWT Secrets — REQUIRED (app will not start without these)
# Generate secure secrets with: openssl rand -base64 32
# NEVER use these placeholder values in production.
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"

# Razorpay Payment Gateway Configuration
# Get your Test / Live API Keys from: https://dashboard.razorpay.com/app/keys
# If left empty, NEXUS runs in built-in realistic Razorpay Sandbox Simulator mode.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
