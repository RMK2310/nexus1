{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "description": "NEXUS Multi-Module Super-App Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npx tsc --project packages/shared/tsconfig.json && cd packages/database && npx prisma generate && npx tsc && cd ../.. && npm run build --workspace=apps/backend",
    "start:backend": "node apps/backend/dist/src/main.js",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "sync:android": "npm run build:mobile && npx cap sync android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "deploy:firebase": "firebase deploy --only hosting",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "typescript": "^5.3.3"
  }
}
