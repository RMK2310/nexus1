{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "description": "NEXUS Multi-Module Super-App Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
